WANDB_API_KEY=

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=synth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PASSWORD

VALIDATOR_COLDKEY_NAME=
VALIDATOR_HOTKEY_NAME=
NETWORK=
NETUID=
LOG_ID_PREFIX=

# Pyth API key for Lazer (Pro) backend. If set, the miner will use Pyth Lazer instead of Hermes for assets with a Lazer feed.
PYTH_API_KEY=

# Bigtable storage backend for miner predictions. Only required when the
# validator is launched with `--storage.backend bigtable`. Two tables are
# used so that retention is enforced by per-table GC policy: one for the
# `low` prompt (e.g. 60d max-age) and one for the `high` prompt (e.g. 12d).
BIGTABLE_PROJECT=
BIGTABLE_INSTANCE=
BIGTABLE_TABLE_PREDICTION_LOW=miner_predictions_low
BIGTABLE_TABLE_PREDICTION_HIGH=miner_predictions_high
